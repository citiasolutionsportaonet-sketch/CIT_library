# Copie para .env e substitua TODOS os valores SUBSTITUIR_*.
# Gere segredos com: openssl rand -hex 32
# Senhas em URLs precisam estar URL-encoded (hex puro não precisa).

# --- PostgreSQL (Docker Compose) ---
POSTGRES_PASSWORD=SUBSTITUIR_SENHA_DONO_DO_BANCO
POSTGRES_PORT=5432
# Senha do papel restrito usado pelo aplicativo (criado por npm run db:deploy)
APP_DB_PASSWORD=SUBSTITUIR_SENHA_APP

# Dono do schema: usado SOMENTE por migrações, grants, backup e restauração.
MIGRATION_DATABASE_URL=postgresql://cit:SUBSTITUIR_SENHA_DONO_DO_BANCO@127.0.0.1:5432/cit_library
# Papel restrito do aplicativo e do worker.
DATABASE_URL=postgresql://cit_app:SUBSTITUIR_SENHA_APP@127.0.0.1:5432/cit_library

# --- Autenticação ---
BETTER_AUTH_SECRET=SUBSTITUIR_SEGREDO_ALEATORIO
# URL canônica que TODOS os Macs usam no navegador (ver docs/rede-local.md)
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
# Lista separada por vírgulas de origens exatas aceitas
TRUSTED_ORIGINS=http://localhost:3000

# --- Arquivos ---
MEDIA_ROOT=./var/media
BACKUP_ROOT=./var/backups

# --- Aplicação ---
DEFAULT_TENANT_SLUG=cit
TZ=America/Sao_Paulo
PORT=3000
# Hostnames/IPs extras liberados para o servidor de desenvolvimento (next dev)
# Ex.: DEV_ALLOWED_ORIGINS=192.168.0.10,cit-servidor.local
DEV_ALLOWED_ORIGINS=

# --- Worker e pesquisa (npm run worker) ---
WORKER_CONCURRENCY=2
RESEARCH_USER_AGENT="CITLibraryBot/0.1 (catalogo interno; contato via administrador)"
# Domínios considerados "oficiais" (separados por vírgula)
RESEARCH_OFFICIAL_DOMAINS=intelbras.com,backend.intelbras.com
# Requisições por minuto por domínio (respeita robots.txt sempre)
RESEARCH_HOST_RPM=20

# Brave Search API (descoberta de página oficial e PDFs). Vazio = desativado.
BRAVE_SEARCH_API_KEY=
BRAVE_COST_CENTS_PER_CALL=3
BRAVE_SEARCH_DAILY_MAX_CALLS=500

# Mercado Livre (API oficial). Use ML_ACCESS_TOKEN ou o trio de app + refresh token.
ML_ACCESS_TOKEN=
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
ML_REDIRECT_URI=
ML_COST_CENTS_PER_CALL=0
MERCADOLIVRE_DAILY_MAX_CALLS=2000

# --- API externa /api/v1 ---
API_RATE_PER_MINUTE=120
