{
  "name": "cit-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "tsx scripts/dev-lan.ts",
    "build": "next build",
    "start": "tsx scripts/start.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/guard-dev-db.ts && prisma migrate dev",
    "db:deploy": "prisma migrate deploy && tsx scripts/db-grants.ts",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "bootstrap": "tsx --conditions=react-server scripts/bootstrap.ts",
    "user:reset-password": "tsx --conditions=react-server scripts/reset-password.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "media:reconcile": "tsx --conditions=react-server scripts/media-reconcile.ts",
    "postinstall": "prisma generate",
    "db:local:start": "tsx scripts/pg-local.ts start",
    "db:local:stop": "tsx scripts/pg-local.ts stop",
    "db:local:status": "tsx scripts/pg-local.ts status",
    "test:e2e:setup": "tsx --conditions=react-server scripts/e2e-setup.ts",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "import:catalog": "tsx --conditions=react-server scripts/import-catalog.ts",
    "research": "tsx --conditions=react-server scripts/research.ts",
    "ml:auth": "tsx --conditions=react-server scripts/ml-auth.ts",
    "catalog:organize": "tsx --conditions=react-server scripts/catalog-organize.ts",
    "env:init": "tsx scripts/env-init.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.8",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "file-type": "22.2.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  }
}
